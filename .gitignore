# --- secrets (NEVER commit) ---
.env

# --- data & models (large / regenerated by the pipeline) ---
data/*
!data/.gitkeep
models/*
!models/.gitkeep

# --- python ---
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/
.venv/
venv/
*.egg-info/

# --- OS / editor ---
.DS_Store
.vscode/
.idea/

# --- caches created by the API clients ---
*.cache
cache/

# raw Kaggle download (not tracked)
archive/
